{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:folio-propositions:schema:proposition:v4",
  "title": "Proposition",
  "x-folio-schema-version": 4,
  "x-folio-generated-by": "folio-propositions 0.5.0",
  "x-folio-invariants": [
    "start_char, end_char and text are all null or all non-null.",
    "end_char >= start_char when both are set.",
    "proposition_type is a key of WORKING_TAXONOMY unless is_new_type is true.",
    "shape is a key of SHAPES.",
    "content_iri, when set, is 'urn:folio:shard/' plus 32 lowercase hex characters.",
    "axiom_history[i].sequence == i; entries chain from 'proposition' (each from_status equals the previous to_status); axiom_status equals the last to_status, or 'proposition' when the history is empty.",
    "Only axiom_history[0] may use the 'migrate' action; migrate entries are unsigned, and every other entry has actor_did, a timezone-aware at, and a signature.",
    "Signed entries have strictly increasing at.",
    "(from_status, to_status, action) is in AXIOM_TRANSITION_ACTIONS; 'reject' and 'override' carry a non-blank reason.",
    "Signatures verify over transition_signing_payload (signing payload version 4); this cannot be checked by JSON Schema."
  ],
  "$defs": {
    "ActorRef": {
      "properties": {
        "role": {
          "$ref": "#/$defs/ActorRole"
        },
        "individual_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Individual Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "assumed": {
          "default": false,
          "title": "Assumed",
          "type": "boolean"
        }
      },
      "required": [
        "role"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorRole": {
      "enum": [
        "party",
        "plaintiff",
        "defendant",
        "appellant",
        "appellee",
        "petitioner",
        "respondent",
        "both_parties",
        "court",
        "secondary_source",
        "system",
        "legislature",
        "agency"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "AdjudicationMode": {
      "enum": [
        "ruled",
        "pro_forma",
        "declined"
      ],
      "title": "AdjudicationMode",
      "type": "string"
    },
    "AdjudicatorRef": {
      "properties": {
        "role": {
          "$ref": "#/$defs/ActorRole"
        },
        "individual_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Individual Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "mode": {
          "$ref": "#/$defs/AdjudicationMode",
          "default": "ruled"
        }
      },
      "required": [
        "role"
      ],
      "title": "AdjudicatorRef",
      "type": "object"
    },
    "AxiomAction": {
      "enum": [
        "promote",
        "demote",
        "supersede",
        "reject",
        "override",
        "migrate"
      ],
      "title": "AxiomAction",
      "type": "string"
    },
    "AxiomStatus": {
      "enum": [
        "proposition",
        "promoted",
        "demoted",
        "superseded"
      ],
      "title": "AxiomStatus",
      "type": "string"
    },
    "AxiomTransition": {
      "description": "One recorded, signed (or legacy ``migrate``) status change.",
      "properties": {
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "from_status": {
          "$ref": "#/$defs/AxiomStatus"
        },
        "to_status": {
          "$ref": "#/$defs/AxiomStatus"
        },
        "action": {
          "$ref": "#/$defs/AxiomAction"
        },
        "actor_did": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Did"
        },
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "At"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionSignature"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sequence",
        "from_status",
        "to_status",
        "action",
        "actor_did",
        "at"
      ],
      "title": "AxiomTransition",
      "type": "object"
    },
    "CitationEdge": {
      "properties": {
        "edge_type": {
          "$ref": "#/$defs/CitationEdgeType"
        },
        "authority_individual_id": {
          "title": "Authority Individual Id",
          "type": "string"
        },
        "authority_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority Text"
        }
      },
      "required": [
        "edge_type",
        "authority_individual_id"
      ],
      "title": "CitationEdge",
      "type": "object"
    },
    "CitationEdgeType": {
      "enum": [
        "supports",
        "distinguishes",
        "overrules",
        "follows",
        "cites_record_evidence",
        "interprets",
        "elaborates",
        "cites"
      ],
      "title": "CitationEdgeType",
      "type": "string"
    },
    "Disposition": {
      "enum": [
        "accepted",
        "rejected",
        "revised",
        "unresolved",
        "assumed-arguendo"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "TransitionSignature": {
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "title": "TransitionSignature",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": 4,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "start_char": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Char"
    },
    "end_char": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Char"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "proposition_type": {
      "title": "Proposition Type",
      "type": "string"
    },
    "is_new_type": {
      "default": false,
      "title": "Is New Type",
      "type": "boolean"
    },
    "asserter": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "validator": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdjudicatorRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "disposition": {
      "$ref": "#/$defs/Disposition"
    },
    "citation_edges": {
      "items": {
        "$ref": "#/$defs/CitationEdge"
      },
      "title": "Citation Edges",
      "type": "array"
    },
    "triple_ids": {
      "items": {
        "type": "string"
      },
      "title": "Triple Ids",
      "type": "array"
    },
    "shape": {
      "default": "litigation",
      "title": "Shape",
      "type": "string"
    },
    "axiom_status": {
      "$ref": "#/$defs/AxiomStatus",
      "default": "proposition"
    },
    "content_iri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "pattern": "^urn:folio:shard/[0-9a-f]{32}$",
      "title": "Content Iri"
    },
    "axiom_history": {
      "items": {
        "$ref": "#/$defs/AxiomTransition"
      },
      "title": "Axiom History",
      "type": "array"
    }
  },
  "required": [
    "id",
    "proposition_type",
    "asserter",
    "validator",
    "disposition"
  ],
  "type": "object"
}
